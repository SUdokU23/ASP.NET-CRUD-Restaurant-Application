@model Resto.ViewModels.Auth.RegisterViewModel

@{
    
    Layout = "_Layout";
    
}
@section Style {
    <link rel="stylesheet" href="css/site.css">
    <link rel="stylesheet" href="/css/crud.css">
}

<head>
    <style></style>
    <title>Register</title>
</head>



<form style="margin-top: 30px" class="generic-form" method="post" asp-controller="Auth" asp-action="Register">

    <h2 style="padding: 15px;">Register</h2>
    
    <div class="form-group">
        <label>Password</label>
        <input class="form-control" asp-for="Password" type="password" placeholder="Password">
    </div>
    
    <div class="form-group">
        <label>Confirm Password</label>
        <input class="form-control" asp-for="ConfPass" type="password" placeholder="Confirm Password">
    </div>
    
    <div style="display: flex; justify-content: center ;
     flex-direction: column ; align-items: center; padding: 10px;">
        <button class="btn-crud" type="submit">Register</button>
    </div>
    
</form>


