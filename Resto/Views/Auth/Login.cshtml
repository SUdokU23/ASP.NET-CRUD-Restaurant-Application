@model Resto.ViewModels.Auth.LoginViewModel

@{
    Layout = "_Layout";
}
@section Style {
    <link rel="stylesheet" href="css/site.css">
    <link rel="stylesheet" href="/css/crud.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
}
<head>
    <style></style>
    <title>Login</title>
</head>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<form style="margin-top: 30px;" class="generic-form" method="post" asp-controller="Auth" asp-action="Login">

    <h2 style="padding: 15px;">Login</h2>
    <div class="form-group">
        <label>Id:</label>
        <input class="form-control" asp-for="Id" type="text" placeholder="Id">
    </div>
    
    <div class="form-group">
        <label>Password</label>
        <input class="form-control" asp-for="Password" type="password" placeholder="Password">
    </div>
    
    <div style="display: flex; justify-content: center ; flex-direction: column ; align-items: center; padding: 10px;">
        <button class="btn-crud" type="submit">Login</button>
    </div>
    

</form>