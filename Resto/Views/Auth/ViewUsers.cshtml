@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Resto.Models.User>

@{
    ViewData["Title"] = "View users";
}

@section Style {
    <link rel="stylesheet" href="css/site.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/crud.css">
}

<div class="menu-items">
    @foreach (var user in Model)
    {
        <div class="tables">
            <p class="main-font">User @user.Id</p>
            <p class="main-font">Administrator: @(user.IsAdministrator ? "Yes" : "No")</p>
            
            @if (!user.IsAdministrator)
            {
                <a class="btn-crud" href="javascript:alert('Contact the DB admin!!!');" class="btn-crud">Make administrator</a>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/Reservation/Index.js" defer="defer" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
}
