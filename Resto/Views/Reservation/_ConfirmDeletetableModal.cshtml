<div class="modal fade" id="_ConfirmDeleteTableModal" tabindex="-1" aria-labelledby="deleteModalLabel" inert="inert">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this Table? Id: <strong id="tableIdDisplay"></strong>?
            </div>
            <div class="modal-footer">
                <form asp-action="DeleteTable" asp-controller="Reservation" method="post">
                    <input type="hidden" name="tableId" id="tableIdInput" />
                    <button type="submit" class="btn-crud btn-danger">Delete</button>
                    <button type="button" class="btn-crud btn-secondary" data-bs-dismiss="modal" onclick="closeModal()">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>
