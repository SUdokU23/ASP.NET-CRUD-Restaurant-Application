@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<Resto.Models.Table>;
@if (User.IsInRole("Administrator"))
{
    @await Html.PartialAsync("_ConfirmDeleteTableModal")
    @await Html.PartialAsync("_EditModal")
}

@{
    ViewData["Title"] = "Reservation Page";
}

@section Style {
    <link rel="stylesheet" href="css/site.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/crud.css">
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}   
<div class="filter-section">
    <form class="reserve-box" method="post" asp-action="Index" asp-controller="Reservation">

        <label for="seats">Select number of seats:</label>
        <select id="seats" name="numberOfSeats" onchange="this.form.submit()">
            <option value="0">Any number of seats</option>
            @for (int i = 1; i <= 6; i++)
            {
                @if (ViewBag.NumberOfSeats == i)
                {
                    <option value="@i" selected="selected">@i</option>
                }
                else
                {
                    <option value="@i">@i</option>
                }
            }
        </select>

        <label>
            <input type="checkbox" name="isAvailable" value="true" @(ViewBag.isAvailable == true ? "checked" : "") onchange="this.form.submit()"/>
            Available
        </label>
        
    </form>

    @if (User.IsInRole("Administrator"))
    {
        <a class="addDelete-item" asp-action="AddTable" type="get">Add Table</a>
    }

</div>

<div class="menu-items">
    @foreach (var item in Model)
    {
        <div class="tables">
            <p class="main-font">Table: @item.Id | Seats: @item.Seats</p>
            <a class="btn-crud" formmethod="get" asp-action="ReserveTable" asp-controller="Reservation" asp-route-id="@item.Id">
                Make reservation
            </a>
            @if (User.IsInRole("Administrator"))
            {
                <button class="btn-crud" href="javascript:void(0);" onclick="openEditModal('@item.Id')">Edit</button>
                <button class="btn-crud" href="javascript:void(0);" onclick="openDeleteModal('@item.Id')">Delete</button>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/Reservation/Index.js" defer="defer" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
}
