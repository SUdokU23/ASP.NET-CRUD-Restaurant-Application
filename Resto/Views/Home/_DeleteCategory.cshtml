
<!-- Delete Category Modal -->
<div class="modal fade" id="_DeleteCategory" tabindex="-1" aria-labelledby="deleteModalLabel" inert="inert">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="DeleteCategory" method="post">
                    <label for="categorySelect">Choose a category to delete:</label>
                    <select id="categorySelect" name="category" class="form-select" required>
                        <!-- JS will populate this -->
                    </select>

                    <div class="mt-3 d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeDeleteCategoryModal()">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
