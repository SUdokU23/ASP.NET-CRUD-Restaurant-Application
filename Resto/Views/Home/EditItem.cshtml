@model Resto.ViewModels.Menu.EditItemViewModel

@{
    ViewData["Title"] = "Add item Page";
}

@section Style {
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/css/crud.css">
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}



<div asp-validation-summary="All" class="text-danger"></div>

<form style="margin-top: 30px;" class="generic-form" asp-action="EditItem" method="post" enctype="multipart/form-data">
    
    <input type="hidden" asp-for="Item.Id" value="@Model.Item.Id"></input>
    <div class="form-group">
        <label asp-for="Item.Name">Item name:</label>
        <input class="form-control" type="text" asp-for="Item.Name" placeholder="Item Name" value="@Model.Item.Name"
               required>
    </div>

    <div class="form-group" style="align-items: flex-start;">
        <label asp-for="Item.Description">Description:</label>
        <textarea class="form-control input-description" asp-for="Item.Description"
                  placeholder="Description">@Model.Item.Description</textarea>
    </div>

    <div class="form-group">
        <label asp-for="Item.Weight">Weight in grams:</label>
        <input class="form-control" type="number" step="any" asp-for="Item.Weight" placeholder="200"
               value="@Model.Item.Weight" required>
    </div>

    <div class="form-group checkbox-group">
        <label asp-for="Item.IsAvailable">Is item available:</label>
        <input type="checkbox" asp-for="Item.IsAvailable" style="margin-left: 10px;">
    </div>

    <div class="form-group">
        <label asp-for="Item.Price">Price (lv):</label>
        <input class="form-control" type="number" step="any" asp-for="Item.Price" placeholder="12.5"
               value="@Model.Item.Price" required>
    </div>

    <div class="form-group">
        <label asp-for="CategoryName">Choose category:</label>
        <select class="form-control" asp-for="CategoryName">
            @foreach (var item in (ViewBag.Categories as List<string>)!)
            {
                if (ViewBag.SelectedCategory == item)
                {
                    <option value="@item" selected="selected">
                        @item
                    </option>
                }
                else
                {
                    <option value="@item">
                        @item
                    </option>
                }
            }
        </select>
    </div>

    <div class="form-group" style="align-items: flex-start;">
        <label>Choose image:</label>
        <div style="flex: 1;">
            <input class="form-control file-input" type="file" asp-for="image" accept=".jpg,.jpeg,.png,.webp,.svg"/>
        </div>
    </div>

    <div class="btn-group">
        <button class="btn-crud" type="submit">Submit</button>
        <button class="btn-crud" type="button" onclick="window.location.href='@Url.Action("Index", "Home")'">
            Cancel
        </button>
    </div>
    
</form>
<p style="padding: 50px; color: #FAFDF3" >Note if u have not made any changes pls click cancel else u will be redirected here but with an error!!!!</p>