@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<Resto.ViewModels.Menu.MenuViewModel>;

@if (User.IsInRole("Administrator"))
{
    @await Html.PartialAsync("_ConfirmDeleteItemModal.cshtml")
    @await Html.PartialAsync("_AddCategory")
    @await Html.PartialAsync("_DeleteCategory")
}

@{
    ViewData["Title"] = "Home Page";
}

@section Style {
    <link rel="stylesheet" href="css/site.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/crud.css">
}

<form class="search-form" method="post" asp-action="Index" asp-controller="Home">
    <input type="text" name="search" placeholder="Search..." value="@ViewBag.Search" onkeydown="if(event.key === 'Enter') this.form.submit();" />
    
    <select name="category" onchange="this.form.submit()">
        <option value="none">All Categories</option>
        @foreach (var item in (ViewBag.Categories as List<string>)!)
        {
            if (ViewBag.SelectedCategory == item)
            {
                <option value="@item" selected="selected">
                    @item
                </option>
            }
            else
            {
                <option value="@item">
                    @item
                </option>
            }
        }

        <label>
            <input type="checkbox" name="descending" value="true" @(ViewBag.Descending == true ? "checked" : "") onchange="this.form.submit()"/>
            Sort Descending
        </label>

    </select>
</form>

@if (User.IsInRole("Administrator"))
{
    <div style="display: flex; justify-content: center; align-content: center; gap: 10px; margin-top: 20px;">
        <a class="addDelete-item" type="get" asp-action="AddItem" asp-controller="Home">Add item</a>
        <a class="addDelete-item" href="javascript:void(0);" onclick="openAddCategoryModal()">Add Category</a>
        <a class="addDelete-item" href="javascript:void(0);" onclick="openDeleteCategoryModal()">Delete Category</a>
    </div>
    
}

<div class="menu-items">
    
    @foreach (var item in Model)
    {
        <div class="menu-item">
            <img style="width: auto;height: auto;" src="@item.ImageUrl">
            <p class="main-font">@item.Category - @item.Name</p>
            <p class="secondary-font">@item.Price lv | @item.Weight g</p>
            <p class="secondary-font">@item.Description</p>
            @if (User.IsInRole("Administrator"))
            {
                <a class="btn-crud" asp-action="EditItem" asp-route-id="@item.Id" type="get">Edit</a>
                <a class="btn-crud" href="javascript:void(0);" onclick="openDeleteModal('@item.Id')">Delete</a>
            }
        </div>
    }
    
</div>

@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js" defer="defer"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Home/Index.js" defer="defer"></script>
    <script >
        let categories = @Html.Raw(@Json.Serialize(ViewBag.Categories as List<string>));
        console.log(categories);
    </script>
}


